.next-button{width:100%;margin-top:14px}.next-button:disabled{opacity:.45;cursor:not-allowed;box-shadow:none}
.instruction{text-align:center;margin:11px 0}.game-screen .text-button{margin:auto}
#quit-mission{margin:5px auto 0}
.result-screen{text-align:center;max-width:580px;margin:auto;padding-top:65px}.result-symbol{font-size:72px;margin-bottom:20px}.result-screen h2{font-size:40px}.result-message{color:var(--muted);line-height:1.7;max-width:470px;margin:15px auto 25px}
