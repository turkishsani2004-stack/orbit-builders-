.status-panel{background:linear-gradient(140deg,#102849,#0b1d38);border:1px solid var(--line);border-radius:18px;padding:19px 20px 13px}
.panel-title{display:flex;justify-content:space-between;font-size:10px;letter-spacing:1.5px;font-weight:800;color:#b6c8e1}.live-dot{color:#6be0b5}
.resource-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:13px;margin-top:20px}
.resource{min-width:0;display:grid;grid-template-columns:auto 1fr;align-items:center;column-gap:7px;row-gap:5px}
.resource-icon{font-size:17px}.resource-name{font-size:11px;color:#b5c8e1;white-space:nowrap}.resource strong{grid-column:1/-1;font:700 22px 'Space Grotesk',sans-serif}
