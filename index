<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#07152f">
  <meta name="description" content="Orbit Builders: a junior astronaut mission training game.">
  <title>Orbit Builders | Junior Astronaut Mission Trainer</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <main class="app-shell">
    <header class="topbar">
      <a class="brand" href="#" aria-label="Orbit Builders home">
        <span class="brand-mark">✦</span><span>ORBIT <b>BUILDERS</b></span>
      </a>
      <span class="top-tag">JUNIOR MISSION TRAINER</span>
    </header>

    <section id="welcome-screen" class="screen welcome-screen">
      <div class="hero-art" aria-hidden="true">
        <div class="planet planet-back"></div>
        <div class="planet planet-main"></div>
        <div class="orbit-ring"></div>
        <div class="star star-one">✦</div><div class="star star-two">·</div>
        <div class="star star-three">✧</div>
        <div class="astronaut">👩‍🚀</div>
        <div class="moon-rock"></div>
      </div>
      <div class="welcome-copy">
        <p class="eyebrow">YOUR CREW IS COUNTING ON YOU</p>
        <h1>Build a base.<br><span>Lead a mission.</span></h1>
        <p class="intro">You are the mission commander. Make smart choices, protect your crew, and keep your space base running.</p>
        <button id="start-button" class="button button-primary">Start Mission <span>→</span></button>
        <p class="small-note">A learning game for explorers aged 10–16</p>
      </div>
      <div class="welcome-footer"><span>✦ THINK • PLAN • SURVIVE</span><span>GAME VALUES ARE ILLUSTRATIVE</span></div>
    </section>

    <section id="selection-screen" class="screen hidden">
      <div class="section-heading">
        <p class="eyebrow">MISSION CONTROL / 01</p>
        <h2>Choose your destination</h2>
        <p>Every base has different challenges. Choose where your crew will begin.</p>
      </div>
      <div class="mission-options">
        <button class="mission-card moon-card" data-mission="moon">
          <span class="mission-planet moon-visual" aria-hidden="true">🌕</span>
          <span class="mission-label">MISSION 01</span>
          <strong>Moon Base</strong>
          <span class="mission-desc">Build a safe research base on the Moon. Watch your energy and supplies.</span>
          <span class="choose-link">Choose Moon Base <b>→</b></span>
        </button>
        <button class="mission-card mars-card" data-mission="mars">
          <span class="mission-planet mars-visual" aria-hidden="true">🪐</span>
          <span class="mission-label">MISSION 02</span>
          <strong>Mars Base</strong>
          <span class="mission-desc">Support a crew on the Red Planet. Plan carefully for a distant outpost.</span>
          <span class="choose-link">Choose Mars Base <b>→</b></span>
        </button>
      </div>
      <button class="text-button" id="back-welcome">← Back</button>
    </section>

    <section id="game-screen" class="screen hidden">
      <div class="game-heading">
        <div>
          <p class="eyebrow">MISSION IN PROGRESS</p>
          <h2 id="base-title">Moon Base</h2>
          <p id="base-subtitle" class="muted">Keep your crew safe and your base running.</p>
        </div>
        <div class="day-pill"><span>MISSION DAY</span><strong id="day-number">1</strong></div>
      </div>

      <div class="status-panel">
        <div class="panel-title"><span>BASE STATUS</span><span class="live-dot">● LIVE</span></div>
        <div class="resource-grid">
          <div class="resource"><span class="resource-icon">🫁</span><span class="resource-name">Oxygen</span><strong id="oxygen-value">80</strong><div class="meter"><i id="oxygen-bar"></i></div></div>
          <div class="resource"><span class="resource-icon">💧</span><span class="resource-name">Water</span><strong id="water-value">75</strong><div class="meter"><i id="water-bar"></i></div></div>
          <div class="resource"><span class="resource-icon">🥫</span><span class="resource-name">Food</span><strong id="food-value">70</strong><div class="meter"><i id="food-bar"></i></div></div>
          <div class="resource"><span class="resource-icon">⚡</span><span class="resource-name">Energy</span><strong id="energy-value">75</strong><div class="meter"><i id="energy-bar"></i></div></div>
          <div class="resource health-resource"><span class="resource-icon">❤️</span><span class="resource-name">Crew Health</span><strong id="health-value">90</strong><div class="meter"><i id="health-bar"></i></div></div>
        </div>
        <p class="scale-note">Resource levels are game points from 0–100, not real engineering measurements.</p>
      </div>

      <div class="decision-heading">
        <div><p class="eyebrow">COMMANDER'S CHOICES</p><h3>What will you do today?</h3></div>
        <span class="choice-count" id="choice-count">Choose 1 action</span>
      </div>
      <div id="decision-grid" class="decision-grid">
        <button class="decision-card" data-action="water"><span class="decision-icon">💧</span><span class="decision-copy"><strong>Conserve water</strong><small>Reuse water and fix small leaks.</small></span><span class="card-arrow">→</span></button>
        <button class="decision-card" data-action="solar"><span class="decision-icon">☀️</span><span class="decision-copy"><strong>Repair solar panels</strong><small>Restore power for the base.</small></span><span class="card-arrow">→</span></button>
        <button class="decision-card" data-action="food"><span class="decision-icon">🌱</span><span class="decision-copy"><strong>Grow food</strong><small>Start a small indoor food garden.</small></span><span class="card-arrow">→</span></button>
        <button class="decision-card" data-action="shield"><span class="decision-icon">🛡️</span><span class="decision-copy"><strong>Improve radiation protection</strong><small>Make a safer shelter for the crew.</small></span><span class="card-arrow">→</span></button>
      </div>
      <div id="feedback" class="feedback hidden" role="status" aria-live="polite"></div>
      <button id="next-day" class="button button-primary next-button" disabled>Next Day <span>→</span></button>
      <p class="instruction">Choose one action each day. Your crew uses supplies every day, so plan ahead.</p>
      <button id="quit-mission" class="text-button">End mission and choose again</button>
    </section>

    <section id="result-screen" class="screen result-screen hidden">
      <div class="result-symbol" id="result-symbol">🏆</div>
      <p class="eyebrow" id="result-eyebrow">MISSION COMPLETE</p>
      <h2 id="result-title">Mission Success!</h2>
      <p id="result-message" class="result-message"></p>
      <div id="final-stats" class="final-stats"></div>
      <button id="restart-button" class="button button-primary">Restart Mission <span>↻</span></button>
      <button id="choose-again" class="text-button">Choose another base</button>
    </section>

    <footer class="site-footer">ORBIT BUILDERS <span>•</span> LEARN BY EXPLORING <span>•</span> NOT REAL NASA PREDICTIONS</footer>
  </main>
  <script src="game.js"></script>
</body>
</html>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap');
:root{--bg:#061329;--panel:#0c2040;--panel2:#10294e;--line:#25446b;--text:#f3f7ff;--muted:#a8bad4;--cyan:#62e5e8;--blue:#638cff;--gold:#ffc96b;--danger:#ff777e}
*{box-sizing:border-box}
body{margin:0;min-height:100vh;background:radial-gradient(ellipse at 75% 0%,#17345d 0,transparent 42%),var(--bg);color:var(--text);font-family:'DM Sans',sans-serif}
button{font:inherit}
.app-shell{width:min(100% - 32px,920px);margin:auto;min-height:100vh;display:flex;flex-direction:column}
.topbar{height:72px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #ffffff12}
.brand{display:flex;gap:9px;align-items:center;color:var(--text);text-decoration:none;font:700 14px 'Space Grotesk',sans-serif;letter-spacing:1.2px}
.brand b{color:var(--cyan)}.brand-mark{font-size:24px;color:var(--cyan)}
.top-tag,.eyebrow,.mission-label{font-size:10px;font-weight:800;letter-spacing:1.7px;color:var(--cyan)}
.top-tag{color:#9fb4d2}
.screen{padding:38px 0 28px;flex:1}.hidden{display:none!important}
.welcome-screen{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:24px;min-height:610px;position:relative}
.hero-art{height:390px;position:relative;overflow:hidden;border-radius:28px;background:linear-gradient(145deg,#102c54,#091a36);border:1px solid #31517a}
.planet{position:absolute;border-radius:50%}.planet-back{width:90px;height:90px;background:#b7c7d9;top:42px;right:35px;opacity:.8;box-shadow:0 0 45px #a9c6ef66}
.planet-main{width:220px;height:220px;background:linear-gradient(140deg,#e7e5d7,#8f9eae 70%);left:50%;top:115px;transform:translateX(-50%);box-shadow:inset -24px -15px 35px #53627a,0 0 65px #b6d2ff22}
.planet-main:before,.planet-main:after{content:"";position:absolute;background:#7f8a9a66;border-radius:50%;width:38px;height:22px;top:50px;left:48px;transform:rotate(-20deg)}
.planet-main:after{width:26px;height:17px;left:135px;top:130px}
.orbit-ring{position:absolute;width:320px;height:100px;border:2px solid #65dce777;border-radius:50%;left:50%;top:185px;transform:translateX(-50%) rotate(-20deg)}
