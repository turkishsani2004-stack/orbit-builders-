.moon-rock{position:absolute;bottom:-40px;left:-20px;width:120%;height:100px;background:#75869b;border-radius:50% 50% 0 0;opacity:.35}
.star{position:absolute;color:#fff;font-size:28px}.star-one{top:50px;left:50px}.star-two{top:140px;right:55px;font-size:40px}.star-three{bottom:85px;left:70px;color:var(--cyan)}
.welcome-copy{padding:15px 8px}.welcome-copy h1,.section-heading h2,.game-heading h2,.result-screen h2{font:700 clamp(34px,5vw,54px)/1.08 'Space Grotesk',sans-serif;letter-spacing:-1.5px;margin:13px 0}
.welcome-copy h1 span{color:var(--cyan)}.intro,.section-heading>p:last-child,.muted{color:var(--muted);line-height:1.7;max-width:440px}
.button{border:0;border-radius:12px;padding:16px 22px;font-weight:800;cursor:pointer;min-height:54px;transition:transform .15s,filter .15s}
.button:hover:not(:disabled){transform:translateY(-2px);filter:brightness(1.08)}
.button-primary{background:linear-gradient(100deg,#54dfe3,#7b9dff);color:#06152e;box-shadow:0 9px 28px #4cdce533}
