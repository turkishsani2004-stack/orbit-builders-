 .mission-options{grid-template-columns:1fr}.mission-card{min-height:245px;padding:20px}.mission-planet{height:60px;font-size:50px}
 .resource-grid{grid-template-columns:repeat(3,1fr);row-gap:17px}.resource{padding:2px 4px}.resource-name{font-size:10px}
 .decision-grid{grid-template-columns:1fr}.decision-card{min-height:72px}.game-heading h2{font-size:27px}.muted{font-size:12px}
 .final-stats{grid-template-columns:repeat(3,1fr)}.result-screen{padding-top:30px}.result-screen h2{font-size:34px}
 .site-footer{line-height:1.8}
}
