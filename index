// Orbit Builders - simple, illustrative resource-management game.
const screens = {
  welcome: document.getElementById("welcome-screen"),
  selection: document.getElementById("selection-screen"),
  game: document.getElementById("game-screen"),
  result: document.getElementById("result-screen")
};

const initialResources = { oxygen: 80, water: 75, food: 70, energy: 75, health: 90 };
const labels = { oxygen: "Oxygen", water: "Water", food: "Food", energy: "Energy", health: "Crew Health" };
const actions = {
  water: {
    title: "Conserve water",
    message: "Good planning! Reusing water and fixing leaks saves supplies.",
    change: { water: 15, energy: -5 }
  },
  solar: {
    title: "Repair solar panels",
    message: "The panels are working better. Your base gains energy.",
    change: { energy: 20, health: 2 }
  },
  food: {
    title: "Grow food",
    message: "Your indoor garden is growing. The crew has more food for later.",
    change: { food: 17, water: -8, energy: -5 }
  },
  shield: {
    title: "Improve radiation protection",
    message: "The crew has a safer shelter. This costs materials and energy.",
    change: { health: 15, energy: -10 }
  }
};

let state = null;
let selectedAction = null;

function showScreen(name) {
  Object.values(screens).forEach(screen => screen.classList.add("hidden"));
  screens[name].classList.remove("hidden");
  window.scrollTo({ top: 0, behavior: "smooth" });
}

function startMission(destination) {
  state = {
    destination,
    day: 1,
    resources: { ...initialResources },
    maxDays: 7,
    actionTaken: false
  };
  const isMars = destination === "mars";
  if (isMars) {
    state.resources.energy = 65;
    state.resources.water = 65;
    state.resources.health = 85;
    state.maxDays = 7;
  }
  document.getElementById("base-title").textContent = isMars ? "Mars Base" : "Moon Base";
  document.getElementById("base-subtitle").textContent = isMars
    ? "A distant outpost needs careful supply planning."
    : "A lunar research base needs careful energy and supply planning.";
  selectedAction = null;
  document.getElementById("feedback").classList.add("hidden");
  document.getElementById("next-day").disabled = true;
  updateDashboard();
  resetActionCards();
  showScreen("game");
}

function clamp(value) { return Math.max(0, Math.min(100, value)); }

function updateDashboard() {
  document.getElementById("day-number").textContent = state.day;
  Object.entries(state.resources).forEach(([key, value]) => {
    document.getElementById(`${key}-value`).textContent = value;
    document.getElementById(`${key}-bar`).style.width = `${value}%`;
    document.querySelector(`[data-resource="${key}"]`)?.classList.toggle("low", value <= 25);
    const resourceEl = document.getElementById(`${key}-value`).closest(".resource");
    resourceEl.classList.toggle("low", value <= 25);
    resourceEl.setAttribute("aria-label", `${labels[key]}: ${value} out of 100`);
  });
  document.getElementById("choice-count").textContent = state.actionTaken ? "Action completed" : "Choose 1 action";
}

function resetActionCards() {
  document.querySelectorAll(".decision-card").forEach(card => {
    card.disabled = false;
    card.classList.remove("selected");
  });
}

function chooseAction(key, card) {
  if (!state || state.actionTaken) return;
  selectedAction = key;
  const action = actions[key];
  Object.entries(action.change).forEach(([resource, amount]) => {
    state.resources[resource] = clamp(state.resources[resource] + amount);
  });
  state.actionTaken = true;
  document.querySelectorAll(".decision-card").forEach(item => {
    item.disabled = true;
    item.classList.toggle("selected", item === card);
  });
  const feedback = document.getElementById("feedback");
  feedback.textContent = `${action.title}: ${action.message} Your supplies will still be used overnight.`;
  feedback.classList.remove("hidden");
  document.getElementById("next-day").disabled = false;
  updateDashboard();
}

function advanceDay() {
  if (!state || !state.actionTaken) return;
  // Daily use is deliberately simple and labelled as game-only values.
  const dailyUse = state.destination === "mars"
    ? { oxygen: -9, water: -9, food: -8, energy: -7, health: -2 }
    : { oxygen: -8, water: -8, food: -7, energy: -6, health: -1 };
  Object.entries(dailyUse).forEach(([key, amount]) => {
    state.resources[key] = clamp(state.resources[key] + amount);
  });
  if (state.resources.oxygen <= 0 || state.resources.water <= 0 ||
      state.resources.food <= 0 || state.resources.energy <= 0 ||
      state.resources.health <= 0) {
    finishMission(false);
    return;
  }
  if (state.day >= state.maxDays) {
    finishMission(true);
    return;
  }
  state.day += 1;
  state.actionTaken = false;
  selectedAction = null;
  document.getElementById("feedback").classList.add("hidden");
  document.getElementById("next-day").disabled = true;
  resetActionCards();
  updateDashboard();
}

function finishMission(success) {
  showScreen("result");
  document.getElementById("result-symbol").textContent = success ? "🏆" : "🛰️";
  document.getElementById("result-eyebrow").textContent = success ? "MISSION COMPLETE" : "MISSION ENDED";
  document.getElementById("result-title").textContent = success ? "Mission Success!" : "Mission Failed";
  const message = success
    ? `You kept ${state.destination === "mars" ? "Mars Base" : "Moon Base"} operating for ${state.maxDays} days. Great command work! You balanced supplies and protected your crew.`
    : "One or more important resources reached zero. The crew could not safely continue. Try again and plan how each choice affects your supplies.";
  document.getElementById("result-message").textContent = message;
  document.getElementById("final-stats").innerHTML = Object.entries(state.resources)
    .map(([key, value]) => `<div class="final-stat"><span>${labels[key]}</span><strong>${value}</strong></div>`).join("");
}

document.getElementById("start-button").addEventListener("click", () => showScreen("selection"));
document.getElementById("back-welcome").addEventListener("click", () => showScreen("welcome"));
document.querySelectorAll(".mission-card").forEach(card => {
  card.addEventListener("click", () => startMission(card.dataset.mission));
});
document.querySelectorAll(".decision-card").forEach(card => {
  card.addEventListener("click", () => chooseAction(card.dataset.action, card));
});
document.getElementById("next-day").addEventListener("click", advanceDay);
document.getElementById("quit-mission").addEventListener("click", () => showScreen("selection"));
document.getElementById("restart-button").addEventListener("click", () => startMission(state.destination));
document.getElementById("choose-again").addEventListener("click", () => showScreen("selection"));
