.decision-heading{display:flex;justify-content:space-between;align-items:end;margin:28px 0 13px}.decision-heading .eyebrow{margin:0 0 5px}.decision-heading h3{margin:0;font:700 21px 'Space Grotesk',sans-serif}.choice-count{font-size:10px;color:var(--muted)}
.decision-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.decision-card{display:flex;align-items:center;gap:12px;text-align:left;padding:14px;background:#0d2140;border:1px solid #25446b;border-radius:13px;color:var(--text);cursor:pointer;min-height:82px}
